# Idara — Manager Workspace
# Basic hardening (works on Apache / LiteSpeed — Hostinger)

Options -Indexes

# Files that must never be served to the public:
# configuration, install-time helpers, deployment diagnostics and documentation.
<FilesMatch "^(config\.php|seed\.php|schema.*\.sql|diag\.php|integrity\.php|README\.md|UPLOAD-INSTRUCTIONS\.txt)$">
  Require all denied
</FilesMatch>

RedirectMatch 403 ^/(includes|data|storage|sql|lang)/

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
